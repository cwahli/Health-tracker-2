{
  "id": "UC-01",
  "title": "New User Weight Loss Multi-Turn Onboarding (18yo Female, 40kg)",
  "description": "Multi-turn onboarding for an 18-year-old female from Indonesia weighing 40kg (135cm) with no medical conditions who asks to lose weight. Receptionist gathers required demographic and biometric data across turns, consolidates memory, and passes the context to the Health Coach to evaluate appropriate nutritional guidance and metabolic targets for a low-bodyweight user.",
  "systemInstruction": [
    "You are the Receptionist and Onboarding AI Specialist for an advanced Health & Biomarker Tracker application.",
    "Your role is to welcome users, understand goals, manage memory, and route to specialized agents."
  ],
  "userPayload": {
    "promptText": [
      "<user_message>",
      "I want to loose weight",
      "</user_message>"
    ],
    "jsonPayload": {
      "currentUserMessage": "I want to loose weight",
      "chatHistory": [
        {
          "role": "user",
          "content": "I want to loose weight"
        }
      ],
      "existingUserProfile": null,
      "existingMemory": null,
      "existingActivitiesAndTasks": null
    }
  },
  "turns": [
    {
      "turnIndex": 1,
      "userMessage": "I want to loose weight",
      "expectedOutput": {
        "intent": "weight_loss",
        "targetAgent": "health_coach",
        "status": "needs_info",
        "expectedMissingFields": [
          "gender",
          "age",
          "height",
          "weight",
          "activity_level"
        ],
        "mustIncludeInResponse": [
          "plan"
        ],
        "memoryValidation": {
          "goalSummaryIncludes": [
            "weight"
          ],
          "stateEquals": "onboarding_gather_info"
        },
        "expectsUiForm": true,
        "handoffValidation": {
          "hasPayload": false
        }
      }
    },
    {
      "turnIndex": 2,
      "userMessage": "I'm an 18-year-old woman from Indonesia, 135cm tall. No medical conditions.",
      "expectedOutput": {
        "intent": "weight_loss",
        "targetAgent": "health_coach",
        "status": "needs_info",
        "expectedMissingFields": [
          "weight"
        ],
        "mustIncludeInResponse": [
          "weight"
        ],
        "memoryValidation": {
          "goalSummaryIncludes": [
            "weight"
          ],
          "stateEquals": "onboarding_gather_info",
          "userProfileSnapshotCheck": {
            "age": 18,
            "gender": "female",
            "ethnicity": "Indonesian",
            "heightCm": 135
          }
        },
        "expectsUiForm": true,
        "handoffValidation": {
          "hasPayload": false
        }
      }
    },
    {
      "turnIndex": 3,
      "userMessage": "My current weight is 40kg and I want to lose weight. I have a student lifestyle with light daily walking.",
      "expectedOutput": {
        "intent": "weight_loss",
        "targetAgent": "health_coach",
        "status": "ready_for_handoff",
        "expectedMissingFields": [],
        "mustIncludeInResponse": [
          "weight"
        ],
        "memoryValidation": {
          "goalSummaryIncludes": [
            "weight"
          ],
          "stateEquals": "ready_for_handoff",
          "userProfileSnapshotCheck": {
            "age": 18,
            "gender": "female",
            "ethnicity": "Indonesian",
            "heightCm": 135,
            "weightKg": 40
          }
        },
        "handoffValidation": {
          "targetAgent": "health_coach",
          "hasPayload": true
        }
      }
    },
    {
      "turnIndex": 4,
      "userMessage": "What's the best weight for me?",
      "specialistContainers": {
        "healthCoachPlan": {
          "globalSummary": "Focus on lean body recomposition, preserving skeletal muscle while establishing healthy metabolic stamina.",
          "timelineToOptimal": "8 to 12 weeks",
          "topNutrientTargets": [
            { "nutrientKey": "calories", "targetValue": "1,450 - 1,550 kcal/day" },
            { "nutrientKey": "protein", "targetValue": "60 - 70 g/day" }
          ],
          "dailyActivities": [
            { "activity": "Light daily walking 6,000 - 8,000 steps" }
          ]
        }
      },
      "expectedOutput": {
        "intent": "weight_loss",
        "targetAgent": "general_receptionist",
        "status": "needs_info",
        "expectedMissingFields": [],
        "mustIncludeInResponse": [
          "kg"
        ],
        "memoryValidation": {
          "stateEquals": "ongoing_support"
        },
        "handoffValidation": {
          "hasPayload": false
        }
      }
    }
  ]
}
